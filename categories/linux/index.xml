&lt;td class="lntd">
&lt;pre tabindex="0" class="chroma">&lt;code class="language-bash" data-lang="bash">&lt;span class="line">&lt;span class="cl">% chmod +x script.sh
&lt;/span>&lt;/span>&lt;span class="line">&lt;span class="cl">% ./script.sh
